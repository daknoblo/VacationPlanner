# Copy to .env for non-secret configuration. Never commit real secrets.
# Inject secrets from your deployment secret manager into the runtime environment;
# do not put them in this file, Compose YAML, image build arguments, or logs.
# AI is optional; CSRF_KEY is required in production.

# ---- AI: Microsoft Foundry / Azure OpenAI identity only ----
# Leave all identity fields empty to disable AI; partial identity is an error.
# Set ALL four required values to enable AI. AZURE_CLIENT_SECRET is runtime-only.
# Resource ID must identify an ACCOUNT, not a Foundry project or deployment:
# /subscriptions/<subscription-id>/resourceGroups/<resource-group>/providers/Microsoft.CognitiveServices/accounts/<account-name>
AZURE_RESOURCE_ID=
AZURE_TENANT_ID=
# Application/client ID, NOT the service principal object ID used for RBAC.
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
# Optional independent, read-only deployment inventory using the SAME identity.
# No image generation is implemented; destination photos use Wikipedia lookup.
AZURE_IMAGE_RESOURCE_ID=

# Endpoint is resolved automatically from validated ARM account metadata (OpenAI v1).
# Select a discovered compatible chat deployment in Settings; saved per account in SQLite.
# There are no manual endpoint/model/API-version inputs or environment overrides.
# The app starts one non-blocking background metadata refresh when AI is configured.
# Settings "Refresh discovery" allows explicit refresh; GET/healthchecks never call Azure.
# Discovery never generates content or automatically changes saved deployment selections.
# The separate text check requires cost consent and sends one request with no retry.

# ---- Geocoding & routing (optional) ----
# Optional API keys for keyed providers; the base URLs are set in the app under Settings.
# GEOCODER_API_KEY=     # keyed Photon/Nominatim-compatible geocoder (destination autocomplete)
# ROUTER_API_KEY=       # OpenRouteService key for driving time/distance between stops

# ---- Security ----
# HMAC key that signs CSRF tokens (hex, >= 32 bytes). Generate with:
#   openssl rand -hex 32
# Optional in development (an ephemeral key is generated on startup);
# REQUIRED in production so tokens stay valid across restarts/instances.
CSRF_KEY=

# ---- Optional overrides (defaults shown) ----
# APP_ENV=development     # "production" enables JSON logs, HSTS, secure cookies
# HTTP_ADDR=:8080         # listen address
# DB_PATH=vacation.db     # SQLite database file path
